# ============================================================
# RAILFUSE — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Backend Configuration
RAILFUSE_ENV=development
RAILFUSE_HOST=0.0.0.0
RAILFUSE_PORT=8000
RAILFUSE_DEBUG=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Database (Optional — SQLite used by default in development)
# DATABASE_URL=postgresql://user:password@localhost:5432/railfuse

# Security
# SECRET_KEY=your-secret-key-here

# Optimization Configuration
OPTIMIZER_SEED=42
OPTIMIZER_LOOKAHEAD_DEPTH=3
OPTIMIZER_MAX_ITERATIONS=1000

# Logging
LOG_LEVEL=INFO
