# ============================================================
# RAILFUSE — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Backend Configuration
RAILFUSE_ENV=development
RAILFUSE_HOST=0.0.0.0
RAILFUSE_PORT=8000
RAILFUSE_DEBUG=true

# Optimization Configuration
OPTIMIZER_SEED=42
OPTIMIZER_LOOKAHEAD_DEPTH=3

# Logging
LOG_LEVEL=INFO

# NOTE: The Vite frontend (frontend-react/) uses a proxy to localhost:8000
# configured in vite.config.js — no API URL env var needed for development.
